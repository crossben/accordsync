{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PullItem",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "type",
        "op"
      ],
      "properties": {
        "type": {
          "const": "op",
          "type": "string"
        },
        "op": {
          "$ref": "WireOp"
        }
      }
    },
    {
      "description": "The record left your scope: delete the local copy (ADR-0004).",
      "type": "object",
      "required": [
        "type",
        "record"
      ],
      "properties": {
        "type": {
          "const": "exit",
          "type": "string"
        },
        "record": {
          "type": "string"
        }
      }
    }
  ]
}
